rules_version = '2';

// Vitalis Firestore security rules.
//
// Data model: every piece of user data lives under /users/{uid}/... and is
// readable/writable only by that authenticated user. There is no cross-user
// read access anywhere in this schema, and no collection is publicly
// readable. Deploy with:
//   firebase deploy --only firestore:rules
//
// (Console alternative: Firebase Console -> Firestore Database -> Rules ->
// paste this file's contents -> Publish.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /vitals/{vitalId} {
        allow read, write: if isOwner(uid);
      }

      match /medications/{medId} {
        allow read, write: if isOwner(uid);
      }

      match /journal/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /symptomChecks/{checkId} {
        allow read, write: if isOwner(uid);
      }

      match /insights/{insightId} {
        allow read, write: if isOwner(uid);
      }

      match /documents/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /labResults/{labResultId} {
        allow read, write: if isOwner(uid);
      }

      match /chats/{chatId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
