# Copy this file to .env.local for local development.
# On Vercel, add these under Project Settings -> Environment Variables instead.
# Full setup walkthrough is in README.md.

# ---------------------------------------------------------------------------
# Firebase — client (safe to expose to the browser; NEXT_PUBLIC_ prefix required)
# Firebase Console -> Project settings -> General -> "Your apps" -> Web app -> SDK config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only if you run `firebase emulators:start` locally.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (server-only secret, NEVER prefix with NEXT_PUBLIC_)
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Open the downloaded JSON and copy the three fields below.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full private key including the BEGIN/END lines. If you paste it as
# a single line, keep the \n escape sequences exactly as they appear in the
# downloaded JSON — the app converts them back to real newlines at startup.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Groq — used for fast "Quick" copilot chat responses. Free tier at https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio — used for Gemini 2.5 Flash ("Deep analysis" chat, symptom
# checker, weekly insights, journal summaries). Free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
